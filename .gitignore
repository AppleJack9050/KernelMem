# Vendored third-party headers (16 MB, thousands of files). Re-fetch with:
#   git clone --depth 1 --branch v3.5.1 https://github.com/NVIDIA/cutlass.git
# and copy include/ + tools/util/include/ into third_party/cutlass/.
# NOTE: because this is ignored, the CUTLASS capability does NOT travel with the
# repo -- install it (or set CUTLASS_INCLUDE_DIR) on every machine you run on.
third_party/cutlass/

# Vendored Claude skills from mit-han-lab/kernel-design-agents (28 MB) and its two
# submodules, DongyunZou/ncu-report-skill and DongyunZou/KernelWiki. Re-fetch with:
#   git clone --depth 1 --recurse-submodules --shallow-submodules \
#     https://github.com/mit-han-lab/kernel-design-agents.git third_party/kernel-design-agents
#   python -m utils.install_kda_skills
# IGNORED DELIBERATELY, and not only for size: none of those three repositories
# ships a LICENSE file, so their contents are all-rights-reserved by default and
# must not be committed into this repository. Referencing a local checkout keeps
# provenance with upstream; copying the text in here would not.
third_party/kernel-design-agents/

# Python bytecode. The one exception is solbench_bridge/, which exists in this
# checkout ONLY as Python 3.13 bytecode (no .py sources), so those files are
# the package and must stay tracked.
__pycache__/
*.py[cod]
!solbench_bridge/*.pyc
.pytest_cache/

# Per-run scratch written by main_memory_latest.py next to the run's outputs:
# the reference copy, the kernel under profile, the previous round's rejected
# kernel, the bench driver and the raw ncu/nsys temp files. Named copies of anything worth keeping land in
# run/<batch>/<task>/profile/.
run/**/scratch/
